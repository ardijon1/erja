# Copy to .env and fill with real values
# ADMIN_PASSWORD_HASH must have \$ escaped for @next/env (e.g., "\$2b\$10\$...")
# Railway: add PostgreSQL service, it auto-sets DATABASE_URL
DATABASE_URL="postgresql://user:pass@host:5432/dbname"
ADMIN_PASSWORD_HASH="\$2b\$10\$EXAMPLE_HASH_REPLACE_WITH_BCRYPT_ESCAPED_DOLLARS"
WHATSAPP_NUMBER="989123456789"
SITE_DOMAIN="example.ir"
SESSION_SECRET="replace-with-32-char-random-string-CHANGE_ME"
